<Project Sdk="Microsoft.NET.Sdk">

  <!-- HOTFIX hotfix-save-stop, PROVED: "one Artboard click silently stops every
       save" (cloud data-safety audit, finding 1).

       A HEADLESS harness over the REAL sources, <Compile Include>d straight out of
       src/Quill (NoteModels, LayerModels, LibraryStore, SyncLog): nothing here is
       a copy of the logic under test.

       NOT InvariantGlobalization, on purpose. The defect only exists where
       double.TryParse("∞") is true, i.e. under ICU, which is what the shipped app
       runs on; an invariant-globalization harness would pass vacuously.

       NEGATIVE CONTROLS. Build with -p:Control=silent|parse|apply|repair and the
       project compiles a MUTATED COPY of the shipping file (written to obj/, the
       shipping file is never touched) with exactly one fix switched back off. Each
       mutant must COMPILE and then turn the matching checks red; a mutant that does
       not compile proves nothing, so the target fails the build if its text was not
       found (the mutation silently not applying would be a green "control").

         silent  - Save: the old bare "catch { return; }" and no pre-serialise repair
         parse   - TryParseDimension: the old "v <= 0" test (accepts +Infinity)
         apply   - TryApply: stores a Custom size without checking it
         repair  - PageSizes.Repair: repairs nothing
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Quill.Tools</RootNamespace>
    <AssemblyName>SaveRepairProof</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StoreSrc>..\..\src\Quill\Services\LibraryStore.cs</StoreSrc>
    <ModelsSrc>..\..\src\Quill\Models\NoteModels.cs</ModelsSrc>
    <StoreMut>$(MSBuildProjectDirectory)\obj\mutant\LibraryStore.cs</StoreMut>
    <ModelsMut>$(MSBuildProjectDirectory)\obj\mutant\NoteModels.cs</ModelsMut>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Shim.cs" />
    <Compile Include="..\..\src\Quill\Models\LayerModels.cs" Link="LayerModels.cs" />
    <Compile Include="..\..\src\Quill\Services\SyncLog.cs" Link="SyncLog.cs" />
    <Compile Include="$(StoreSrc)" Link="LibraryStore.cs" Condition="'$(Control)' != 'silent'" />
    <Compile Include="$(ModelsSrc)" Link="NoteModels.cs"
             Condition="'$(Control)' != 'parse' And '$(Control)' != 'apply' And '$(Control)' != 'repair'" />
    <Compile Include="$(StoreMut)" Link="LibraryStore.cs" Condition="'$(Control)' == 'silent'" />
    <Compile Include="$(ModelsMut)" Link="NoteModels.cs"
             Condition="'$(Control)' == 'parse' Or '$(Control)' == 'apply' Or '$(Control)' == 'repair'" />
  </ItemGroup>

  <UsingTask TaskName="MutateFile" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Dest ParameterType="System.String" Required="true" />
      <Find ParameterType="System.String" Required="true" />
      <Replace ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = System.IO.File.ReadAllText(Source);
        int at = text.IndexOf(Find, System.StringComparison.Ordinal);
        if (at < 0 || text.IndexOf(Find, at + 1, System.StringComparison.Ordinal) >= 0)
        {
            Log.LogError("negative control: the text to mutate was not found exactly once in " + Source + ": " + Find);
            return false;
        }
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Dest));
        System.IO.File.WriteAllText(Dest, text.Replace(Find, Replace), new System.Text.UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="MutateSources" BeforeTargets="CoreCompile" Condition="'$(Control)' != ''">
    <MutateFile Condition="'$(Control)' == 'silent'" Source="$(StoreSrc)" Dest="$(StoreMut)"
                Find="var repairs = RepairCheap(lib);" Replace="var repairs = new List&lt;string&gt;();" />
    <MutateFile Condition="'$(Control)' == 'silent'" Source="$(StoreMut)" Dest="$(StoreMut)"
                Find="if (!RecoverFromSerializeFailure(lib, ex, repairs, out json)) return;"
                Replace="{ _ = ex; return; }" />
    <MutateFile Condition="'$(Control)' == 'parse'" Source="$(ModelsSrc)" Dest="$(ModelsMut)"
                Find="if (!IsValidDimension(v)) return false;" Replace="if (v &lt;= 0) return false;" />
    <MutateFile Condition="'$(Control)' == 'apply'" Source="$(ModelsSrc)" Dest="$(ModelsMut)"
                Find="if (!IsStorableDimension(w) || !IsStorableDimension(h)) return false;" Replace=";" />
    <MutateFile Condition="'$(Control)' == 'repair'" Source="$(ModelsSrc)" Dest="$(ModelsMut)"
                Find="        if (bad)&#13;&#10;" Replace="        if (bad &amp;&amp; !bad)&#13;&#10;" />
  </Target>

</Project>
