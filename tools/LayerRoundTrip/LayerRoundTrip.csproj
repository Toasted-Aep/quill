<Project Sdk="Microsoft.NET.Sdk">

  <!-- CONCEPTS-REF 18.11, proved rather than asserted.

       A HEADLESS harness that runs the REAL serialiser over the REAL models and
       the REAL layer functions, so "an existing page loses nothing" is an
       experiment rather than a claim.  Nothing here is a copy: every source file
       below is <Compile Include>d straight out of src/Quill.  Written to the
       pattern tools/VeilRoundTrip set for section 16.7, for the same reason -
       the failure mode is data loss discovered on the next reload, which is
       exactly the kind of thing that looks perfect at the moment it is done.

       net8.0-windows10.0.19041.0 to match VeilRoundTrip; nothing compiled here
       actually needs Windows types.  No WinUI, no Windows App SDK, no window:
       this runs in a console. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Quill.Tools</RootNamespace>
    <AssemblyName>LayerRoundTrip</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Shim.cs" />
    <Compile Include="..\..\src\Quill\Models\NoteModels.cs" Link="NoteModels.cs" />
    <Compile Include="..\..\src\Quill\Models\LayerModels.cs" Link="LayerModels.cs" />
    <Compile Include="..\..\src\Quill\Services\LibraryStore.cs" Link="LibraryStore.cs" />
    <Compile Include="..\..\src\Quill\Services\SyncLog.cs" Link="SyncLog.cs" />
    <!-- The user's ruling made deleting a layer destructive, so the deletion has
         to be undoable and the undo has to bring the CONTENT back. That is
         RemoveLayerAction, and it is proved through the REAL UndoRedoManager
         rather than by calling the action's own methods. -->
    <Compile Include="..\..\src\Quill\Services\UndoRedo.cs" Link="UndoRedo.cs" />
  </ItemGroup>

</Project>
