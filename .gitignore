bin/
obj/
.vs/
graphify-out/
*.log
*.suo
*.user
*.lnk
decomp_*.cs

# Visual Studio project-upgrade log
UpgradeLog*.htm

# MSIX build output (the .appinstaller template IS tracked)
dist/msix/

# scratchpad OUTPUT - rasters, transcripts and the historical Icons.cs the
# comparison pulls out of git. All regenerate from the scripts beside them,
# and a checked-in copy of a source file goes stale the moment anyone edits
# the real one.
scratchpad/*.png
scratchpad/*.txt
scratchpad/_Icons_*.cs
scratchpad/__pycache__/

# Python bytecode from the tools/ checkers
__pycache__/
*.pyc

# Run 25: FULL-SCREEN captures are never committed. A screen-verification run
# shoots the whole desktop to prove the window is really there, and the desktop
# behind it is the user's own. Only crops taken strictly inside Quill's canvas
# go in the repo; the `*-page.png` originals stay local.
scratchpad/vp25/*-page.png
